% LaTeX macros shared by the website (loaded by _includes/mathjax.html)
% and Obsidian (Extended MathJax plugin reads preamble.sty from the vault root).
% Stick to \newcommand / \renewcommand / \def so both MathJax versions accept it.

% Number systems
\newcommand{\RR}{\mathbb{R}}
\newcommand{\CC}{\mathbb{C}}

% Calculus
\newcommand{\de}{\textrm{d}}
\newcommand{\del}{\partial}
\newcommand{\inv}{^{-1}}
\newcommand{\calL}{\mathcal{L}}

% Operators
\newcommand{\Vol}{\operatorname{Vol}}

% Pairing: \<x,y\>
\def\<#1\>{\langle #1 \rangle}
